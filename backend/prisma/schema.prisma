datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  name            String
  role            String   // STUDENT, INDUSTRY, ACADEMICIAN, INSTITUTION_ADMIN, SUPER_ADMIN
  system          String   @default("AYURVEDA") // AYURVEDA, YOGA, UNANI, SIDDHA, HOMEOPATHY, ALL
  avatar          String?
  institutionName String?
  companyName     String?
  designation     String?
  createdAt       DateTime @default(now())

  studentProfile       StudentProfile?
  messagesSent         Message[] @relation("SentMessages")
  messagesRecv         Message[] @relation("RecvMessages")
  notifications        Notification[]
  applications         Application[]
  enrollments          Enrollment[]
  opportunities        Opportunity[]
  academicPrograms     AcademicProgram[]
  targetRoles          TargetRole[]
  assessmentAttempts   AssessmentAttempt[]
  documents            DocumentVault[]
  mentorshipsAsMentor  MentorshipRequest[] @relation("MentorUser")
  mentorshipsAsStudent MentorshipRequest[] @relation("StudentUser")
  researchProposals    ResearchProposal[]
  certificates         Certificate[]
  auditLogs            AuditLog[]
}

model StudentProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  degree               String   @default("BAMS") // BAMS, BHMS, BUMS, BSMS, BNYS, MD/MS (AYUSH)
  passoutYear          Int      @default(2025)
  readinessScore       Int      @default(75)
  bio                  String?
  phone                String?
  location             String?  @default("New Delhi, India")
  skillScores          String   @default("{}") // Self-declared JSON string
  assessedSkills       String   @default("{}") // Backend MCQ test score JSON
  coursePassedSkills   String   @default("{}") // Course test passed score JSON
  mentorVerifiedSkills String   @default("{}") // Mentor verified score JSON
  verifiedBadges       String   @default("[]") // JSON string array of earned certificates
  careerGoals          String   @default("[]") // JSON string array of preferred career track IDs
}

model JobRole {
  id                 String   @id @default(uuid())
  title              String
  code               String   @unique
  system             String   @default("AYURVEDA")
  summary            String
  careerPathway      String
  eligibleDegrees    String
  coreSkills         String
  secondarySkills    String
  typicalSalaryRange String
  demandSignal       String   @default("HIGH")
  createdAt          DateTime @default(now())

  targetRoles TargetRole[]
}

model TargetRole {
  id           String   @id @default(uuid())
  studentId    String
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  jobRoleId    String
  jobRole      JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  targetLevel  Int      @default(85)
  selectedAt   DateTime @default(now())
}

model AssessmentQuestion {
  id            String   @id @default(uuid())
  discipline    String   @default("AYURVEDA")
  skillCategory String
  questionType  String   @default("MCQ") // MCQ, MULTI_SELECT, CLINICAL_CASE, REASONING, APTITUDE, SITUATIONAL_JUDGEMENT, SHORT_ANSWER
  difficulty    String   @default("INTERMEDIATE")
  weight        Int      @default(10)
  questionText  String
  options       String
  correctAnswer String
  explanation   String
  referenceDoc  String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model AssessmentAttempt {
  id                String   @id @default(uuid())
  studentId         String
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discipline        String   @default("AYURVEDA")
  totalScore        Int
  technicalScore    Int
  softSkillScore    Int
  categoryBreakdown String
  answers           String
  completedAt       DateTime @default(now())
}

model Opportunity {
  id                   String   @id @default(uuid())
  title                String
  type                 String
  companyName          String
  companyId            String
  company              User     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  system               String   @default("ALL")
  department           String   @default("R&D / Clinical Operations")
  skillsRequired       String
  preferredSkills      String   @default("[]")
  stipend              String
  location             String
  mode                 String   @default("ONSITE")
  duration             String
  openings             Int      @default(5)
  applicationDeadline  String?  @default("2026-10-31")
  joiningDate          String?  @default("2026-11-15")
  minDegree            String   @default("BAMS")
  eligibleBatch        Int      @default(2025)
  description          String
  selectionStages      String   @default("[\"Application Review\",\"Technical Interview\",\"HR Fit\"]")
  knockoutQuestions    String   @default("[]")
  status               String   @default("PUBLISHED")
  companyVerified      Boolean  @default(true)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())

  applications   Application[]
  internships    InternshipLifecycle[]
}

model Application {
  id            String   @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  studentId     String
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        String   @default("APPLIED")
  matchScore    Int      @default(80)
  matchSnapshot String   @default("{}")
  coverLetter   String?
  answers       String   @default("{}")
  interviewDate String?
  appliedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  timelineEvents TimelineEvent[]
}

model TimelineEvent {
  id            String   @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorName     String
  actorRole     String
  stage         String
  note          String
  createdAt     DateTime @default(now())
}

model Course {
  id                   String   @id @default(uuid())
  title                String
  providerName         String
  companyId            String
  duration             String
  level                String   @default("Intermediate")
  deliveryMode         String   @default("HYBRID")
  system               String   @default("AYURVEDA")
  skillsAcquired       String
  description          String
  learningOutcomes     String   @default("[]")
  modulesJson          String   @default("[]")
  instructorDetails    String   @default("{}")
  capacity             Int      @default(100)
  registrationDeadline String?  @default("2026-11-30")
  passThreshold        Int      @default(75)
  image                String?
  price                String   @default("Free (Ministry Sponsored)")
  enrollmentsCount     Int      @default(0)
  status               String   @default("PUBLISHED")
  createdAt            DateTime @default(now())

  enrollments          Enrollment[]
  modules              Module[]
  resources            LearningResource[]
  assessments          CourseAssessment[]
  certificates         Certificate[]
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  order       Int      @default(1)
  summary     String

  lessons     Lesson[]
}

model Lesson {
  id           String   @id @default(uuid())
  moduleId     String
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  order        Int      @default(1)
  content      String
  videoUrl     String?
  duration     String   @default("15 mins")
  isCompulsory Boolean  @default(true)

  resources    LearningResource[]
  progress     LessonProgress[]
}

model LearningResource {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title       String
  type        String   @default("PDF") // PDF, SOP, SLIDE, WORKSHEET, CASE_STUDY
  fileUrl     String
  fileSize    String   @default("2.4 MB")
  createdAt   DateTime @default(now())
}

model Enrollment {
  id              String    @id @default(uuid())
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId       String
  student         User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status          String    @default("ENROLLED") // ENROLLED, COMPLETED
  progressPercent Int       @default(0)
  quizScore       Int?
  completedAt     DateTime?
  certificateHash String?
  enrolledAt      DateTime  @default(now())

  lessonProgress  LessonProgress[]
  certificates    Certificate[]
}

model LessonProgress {
  id           String    @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       String    @default("LOCKED") // LOCKED, AVAILABLE, IN_PROGRESS, COMPLETED
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt
}

model CourseAssessment {
  id                String   @id @default(uuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  passScorePercent  Int      @default(75)
  timeLimitMinutes  Int      @default(30)
  questionsJson     String   // JSON string array of MCQs
}

model Certificate {
  id                  String   @id @default(uuid())
  certificateNumber   String   @unique
  enrollmentId        String
  enrollment          Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentId           String
  student             User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentName         String
  courseTitle         String
  providerName        String
  issueDate           DateTime @default(now())
  score               Int      @default(85)
  verificationQrToken String
  signatory           String   @default("Ministry of AYUSH & AIIA Academic Cell")
  status              String   @default("VALID") // VALID, REVOKED, EXPIRED
  revocationReason    String?
}

model InternshipLifecycle {
  id                  String    @id @default(uuid())
  opportunityId       String
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  studentId           String
  mentorName          String
  onboardingStatus    String    @default("COMPLETED")
  weeklyLogs          String    @default("[]")
  midpointEvaluation  String    @default("{}")
  finalEvaluation     String    @default("{}")
  completionStatus    String    @default("IN_PROGRESS")
  certificateHash     String?
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
}

model AcademicProgram {
  id              String   @id @default(uuid())
  title           String
  type            String   // FDP, JOINT_RESEARCH, CONSULTANCY, GUEST_LECTURE
  academicianId   String
  academician     User     @relation(fields: [academicianId], references: [id], onDelete: Cascade)
  organizerName   String
  description     String
  targetAudience  String   @default("AYUSH Faculty & Researchers")
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
}

model DocumentVault {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName           String
  fileCategory       String
  fileUrl            String
  fileSize           String   @default("1.2 MB")
  verificationStatus String   @default("VERIFIED")
  checksum           String?
  uploadedAt         DateTime @default(now())
}

model MentorshipRequest {
  id           String   @id @default(uuid())
  studentId    String
  student      User     @relation("StudentUser", fields: [studentId], references: [id], onDelete: Cascade)
  mentorId     String
  mentor       User     @relation("MentorUser", fields: [mentorId], references: [id], onDelete: Cascade)
  topic        String
  notes        String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  sessions     MentorshipSession[]
}

model MentorshipSession {
  id          String   @id @default(uuid())
  requestId   String
  request     MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  studentId   String
  mentorId    String
  scheduledAt String
  agenda      String
  notes       String?
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
}

model ResearchProposal {
  id            String   @id @default(uuid())
  title         String
  academicianId String
  academician   User     @relation(fields: [academicianId], references: [id], onDelete: Cascade)
  industryOrg   String
  discipline    String   @default("AYURVEDA")
  budget        String   @default("₹5,00,000")
  status        String   @default("UNDER_REVIEW")
  createdAt     DateTime @default(now())
}

model IntegrationLog {
  id            String   @id @default(uuid())
  sourceSystem  String
  action        String
  itemsSynced   Int      @default(1)
  status        String   @default("SUCCESS")
  syncedAt      DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorRole    String
  action       String
  targetEntity String
  detailsJson  String   @default("{}")
  timestamp    DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("RecvMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  senderName String
  content    String
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
